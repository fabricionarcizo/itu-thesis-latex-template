% -----------------------------------------------------------------------------
% 4. Thesis-type logic
% -----------------------------------------------------------------------------
% Thesis type configuration: bachelor | master | phd | research. A single
% \thesistype command drives the document level: it sets a boolean for the
% chosen type, auto-fills the type label (\thesis) and the long degree
% wording, and lets the cover/approval sheets self-suppress accordingly.
\newif\ifITUphd
\newif\ifITUmaster
\newif\ifITUbachelor
\newif\ifITUresearch
\providecommand{\thesisdegreelong}{}   % e.g. "Doctor of Philosophy"
\newcommand{\thesistype}[1]{%
    \ITUphdfalse\ITUmasterfalse\ITUbachelorfalse\ITUresearchfalse
    \renewcommand{\thesisdegreelong}{}%
    \ifthenelse{\equal{#1}{phd}}{%
        \ITUphdtrue \thesis{Ph.D. Thesis}%
        \renewcommand{\thesisdegreelong}{Doctor of Philosophy}%
    }{\ifthenelse{\equal{#1}{master}}{%
        \ITUmastertrue \thesis{Master's Thesis}%
        \renewcommand{\thesisdegreelong}{Master of Science}%
    }{\ifthenelse{\equal{#1}{bachelor}}{%
        \ITUbachelortrue \thesis{Bachelor's Thesis}%
        \renewcommand{\thesisdegreelong}{Bachelor of Science}%
    }{\ifthenelse{\equal{#1}{research}}{%
        \ITUresearchtrue \thesis{Research Project}%
    }{\PackageError{ITU}{Unknown thesis type '#1' (use bachelor, master, phd, or research)}{}%
    }}}}%
}


% -----------------------------------------------------------------------------
% 5. Author and co-supervisor lists
% -----------------------------------------------------------------------------
% Both authors and co-supervisors accept one to three entries; each \author /
% \cosupervisor call registers one name into slot a/b/c. \ITU@addentry holds the
% shared slot-assignment logic; the per-family setters add the field sync. The
% abnt fields are kept in sync so emptiness checks and legacy references keep
% working. The grammatical list renderers are kept explicit per family because
% they encode exact, spacing-sensitive output.

% Shared registration: increment counter #1, store #6 into slot #2/#3/#4, and
% raise a package error past the third entry (#5 = plural noun for the message).
\newcommand{\ITU@addentry}[6]{%
    \stepcounter{#1}%
    \ifcase\value{#1}%
        \or\renewcommand#2{#6}%
        \or\renewcommand#3{#6}%
        \or\renewcommand#4{#6}%
        \else\PackageError{ITU}{At most three #5 are supported}%
            {Specify no more than three of these entries.}%
    \fi
}

% Authors. \ITU@authorsinline prints a grammatical list ("A", "A and B", or
% "A, B and C") used in running text; \ITU@authorslined stacks them one per line
% (cover, cover sheet, colophon).
\newcounter{ITU@numauthors}
\providecommand{\ITU@authora}{}
\providecommand{\ITU@authorb}{}
\providecommand{\ITU@authorc}{}
\newcommand{\ITUaddauthor}[1]{%
    \ITU@addentry{ITU@numauthors}{\ITU@authora}{\ITU@authorb}{\ITU@authorc}{authors}{#1}%
    \ABNTsyncauthorfield{\ITU@authorsinline}%
}
\newcommand{\ITU@authorsinline}{%
    \ifcase\value{ITU@numauthors}%
    \or\ITU@authora
    \or\ITU@authora{} and \ITU@authorb
    \or\ITU@authora, \ITU@authorb{} and \ITU@authorc
    \fi
}
\newcommand{\ITU@authorslined}{%
    \ifcase\value{ITU@numauthors}%
    \or\ITU@authora
    \or\ITU@authora\\\ITU@authorb
    \or\ITU@authora\\\ITU@authorb\\\ITU@authorc
    \fi
}

% Co-supervisors. \ITU@cosupinline prints the grammatical list and
% \ITU@cosuplabel gives an adaptive label ("Co-Supervisor:" / "Co-Supervisors:").
\newcounter{ITU@numcosup}
\providecommand{\ITU@cosupa}{}
\providecommand{\ITU@cosupb}{}
\providecommand{\ITU@cosupc}{}
\newcommand{\ITUaddcosupervisor}[1]{%
    \ITU@addentry{ITU@numcosup}{\ITU@cosupa}{\ITU@cosupb}{\ITU@cosupc}{co-supervisors}{#1}%
    \ABNTsynccosupervisorfield{\ITU@cosupinline}%
}
\newcommand{\ITU@cosupinline}{%
    \ifcase\value{ITU@numcosup}%
    \or\ITU@cosupa
    \or\ITU@cosupa{} and \ITU@cosupb
    \or\ITU@cosupa, \ITU@cosupb{} and \ITU@cosupc
    \fi
}
\newcommand{\ITU@cosuplabel}{%
    \ifnum\value{ITU@numcosup}>1 Co-Supervisors:\else Co-Supervisor:\fi
}

% Signature blocks for the cover sheet: a centered rule with the author's name
% centered underneath. \ITU@signatures renders one block per registered author
% (1 to 3), so the signature area adapts to the number of authors.
\newcommand{\ITU@signatureblock}[1]{%
    \rule{0.6\textwidth}{0.5pt}\\[2pt]
    #1\par
}
\newcommand{\ITU@signatures}{%
    \begin{center}
        \ifcase\value{ITU@numauthors}%
        \or
            \ITU@signatureblock{\ITU@authora}%
        \or
            \ITU@signatureblock{\ITU@authora}%
            \vspace{8mm}%
            \ITU@signatureblock{\ITU@authorb}%
        \or
            \ITU@signatureblock{\ITU@authora}%
            \vspace{8mm}%
            \ITU@signatureblock{\ITU@authorb}%
            \vspace{8mm}%
            \ITU@signatureblock{\ITU@authorc}%
        \fi
    \end{center}%
}


