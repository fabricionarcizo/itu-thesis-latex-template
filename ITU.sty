% -----------------------------------------------------------------------------
% 9. Automatic IEEE-style citation builder
% -----------------------------------------------------------------------------
% Automatic IEEE-style bibliographic citation for the colophon, assembled from
% the document metadata (authors, title, thesis type, university, place, year).
% A manual \citationinfo{...} still overrides it (see \infopage).

% Expandable emptiness test (used here and by the colophon).
\newcommand{\ITU@ifempty}[1]{%
    \expandafter\ifx\expandafter\relax\detokenize{#1}\relax
        \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}

% \ITU@initials abbreviates all given names of a full name to initials and keeps
% the surname, e.g. "Fabricio Batista Narcizo" -> "F. B. Narcizo".
\newcommand{\ITU@initials}[1]{\ITU@ini#1 \ITU@ninil}
\def\ITU@ini#1 #2\ITU@ninil{%
    \ITU@ifempty{#2}{#1}{\ITU@fc#1\ITU@ninil.~\ITU@ini#2\ITU@ninil}}
\def\ITU@fc#1#2\ITU@ninil{#1}
% One-expansion wrapper so a stored name macro is split, not its single token.
\newcommand{\ITU@initialsx}[1]{\expandafter\ITU@initials\expandafter{#1}}

% Registered authors joined in IEEE order ("A", "A and B", "A, B, and C").
\newcommand{\ITU@authorsieee}{%
    \ifcase\value{ITU@numauthors}%
    \or\ITU@initialsx{\ITU@authora}%
    \or\ITU@initialsx{\ITU@authora} and \ITU@initialsx{\ITU@authorb}%
    \or\ITU@initialsx{\ITU@authora}, \ITU@initialsx{\ITU@authorb}, and \ITU@initialsx{\ITU@authorc}%
    \fi}

% Year = last space-separated token of the date ("July, 2026" -> "2026").
\newcommand{\ITU@citationyear}{\expandafter\ITU@lwstart\expandafter{\ABNTdatedata}}
\def\ITU@lwstart#1{\ITU@lw#1 \ITU@ninil}
\def\ITU@lw#1 #2\ITU@ninil{\ITU@ifempty{#2}{#1}{\ITU@lw#2\ITU@ninil}}

% Place = the \city value with " -- " normalised to ", ".
\newcommand{\ITU@citationplace}{{\fullexpandarg\StrSubstitute{\ABNTcitydata}{ -- }{, }}}

% The assembled citation.
\newcommand{\ITU@autocitation}{%
    \ITU@authorsieee, ``\ABNTtitledata : \ABNTsubtitledata,'' \ABNTthesisdata,
    \ABNTuniversitydata, \ITU@citationplace, \ITU@citationyear.}


% -----------------------------------------------------------------------------
% 10. Internal layout helpers (shared boilerplate)
% -----------------------------------------------------------------------------
% These factor out page-setup boilerplate that recurs across the cover, sheets,
% pre-textual pages, lists and bibliography. They run in vertical mode between
% page-building operations. Every line ends with % so no stray spaces leak.

% Start on a fresh page, honouring the 'openright' option.
\newcommand{\ITU@clearpage}{%
    \if@openright\cleardoublepage\else\clearpage\fi
}

% Force single-column layout on this page, remembering to restore later.
\newcommand{\ITU@onecolumn}{%
    \if@twocolumn\@restonecoltrue\onecolumn\else\@restonecolfalse\newpage\fi
}

% Save the current two-column state and switch to a single column; the matching
% \ITU@restorecolumns switches back if two-column mode was active.
\newcommand{\ITU@savecolumns}{%
    \ifthenelse{\boolean{@twocolumn}}{%
        \setboolean{ABNTrestorecol}{true}\onecolumn
    }{%
        \setboolean{ABNTrestorecol}{false}%
    }%
}
\newcommand{\ITU@restorecolumns}{%
    \ifthenelse{\boolean{ABNTrestorecol}}{\twocolumn}{}%
}

% Place the decorative chapter glyph (style/#1) at the top of the page.
\newcommand{\ITU@chapterglyph}[1]{%
    \putat{-25}{-121}{\includegraphics[scale=0.08]{style/#1}}%
}

% Place the decorative header glyph (three rules, drawn directly in LaTeX
% instead of style/header.png) at the top of the page, used for unnumbered
% pre-textual chapters, the table of contents, glossary and bibliography.
% Geometry below (all offsets/sizes measured in bp -- "big points", the
% PDF/PostScript unit, i.e. what raster measurements correspond to 1:1 --
% relative to the same (0,0) anchor used by \ITU@chapterglyph, the text-block
% top) was calibrated to match the original artwork pixel-for-pixel. Using bp
% (rather than pt) avoids the ~0.4% pt-to-bp shrink that would otherwise
% throw off the wide rules by a couple of points:
%   - top rule:    x in [-21.12, 431.76], y in [21.12, 27.12]  (height 6.00bp)
%   - middle rule: x in [ 93.12, 431.76], y in [-109.44, -107.52] (height 1.92bp)
%   - bottom rule: x in [159.36, 431.76], y in [-119.28, -114.72] (height 4.56bp)
\newcommand{\ITU@headerglyph}{%
    \begingroup
        \unitlength=1bp%
        \begin{picture}(0,0)(0,0)
            \put(-21.12,21.12){\rule{452.88bp}{6.00bp}}% Top rule
            \put(93.12,-109.44){\rule{338.64bp}{1.92bp}}% Middle rule
            \put(159.36,-119.28){\rule{272.40bp}{4.56bp}}% Bottom rule
        \end{picture}%
    \endgroup
}

% Set / clear \chaptertype for the hyperlinked table of contents.
\newcommand{\ITU@setchaptertype}[1]{%
    \ifthenelse{\boolean{ABNThypertoc}}{\renewcommand{\chaptertype}{#1}}{}%
}
\newcommand{\ITU@clearchaptertype}{%
    \ifthenelse{\boolean{ABNThypertoc}}{\renewcommand{\chaptertype}{}}{}%
}

% Place content at an absolute offset via a zero-sized picture.
%   #1: X offset, #2: Y offset, #3: content.
\newcommand{\putat}[3]{%
    \begin{picture}(0,0)(0,0)% Start a zero-sized picture environment
        \put(#1,#2){#3}% Place the content at the specified coordinates
    \end{picture}%
}


% -----------------------------------------------------------------------------
% 11. Page styles (headers and footers)
% -----------------------------------------------------------------------------

% Plain pages (chapter title pages, etc.): no header or footer.
\renewcommand{\ps@plainheader}{%
    \renewcommand{\@oddfoot}{}% No footer on odd pages
    \renewcommand{\@evenfoot}{}% No footer on even pages
    \renewcommand{\@oddhead}{}% No header on odd pages
    \renewcommand{\@evenhead}{}% No header on even pages
}

% The ITU running page style: thesis type in the footer, an underlined header
% with the running mark and page number.
\newcommand{\ps@itu}{%
    % Footer (odd and even pages): the thesis type.
    \renewcommand{\@oddfoot}{%
        \makebox[\textwidth]{%
            \raisebox{-.5ex}{\footnotesize\ABNTthesisdata}%
        }%
    }%
    \renewcommand{\@evenfoot}{%
        \makebox[\textwidth]{%
            \raisebox{-.5ex}{\footnotesize\ABNTthesisdata}%
        }%
    }%
    % Header for odd pages: running mark left, page number right.
    \renewcommand{\@oddhead}{%
        \underline{%
            \makebox[\textwidth]{%
                \raisebox{-.5ex}{}%
                {\rightmarkformat\rightmark}%
                \hfill
                {\thepageformat\thepage}%
            }%
        }%
    }%
    % Header for even pages: page number left, running mark right.
    \renewcommand{\@evenhead}{%
        \underline{%
            \makebox[\textwidth]{%
                \raisebox{-.5ex}{}%
                {\thepageformat\thepage}%
                \hfill
                {\leftmarkformat\leftmark}%
            }%
        }%
    }%
    % Custom header marking.
    \let\@mkboth\ABNTmarkboth
    \renewcommand{\chaptermark}[1]{%
        \markboth{%
            \ifnum\c@secnumdepth >\m@ne
                \thechapter\ %
            \fi
            ##1%
        }{%
            \ifnum\c@secnumdepth >\m@ne
                \thechapter\ %
            \fi
            ##1%
        }%
    }%
    \renewcommand{\sectionmark}[1]{%
        \markright{%
            \ifnum\c@secnumdepth >\z@
                \thesection\ %
            \fi
            ##1%
        }%
    }%
}


% -----------------------------------------------------------------------------
% 12. Sectioning (parts, chapters, chapter heads)
% -----------------------------------------------------------------------------

% Part pages in the table of contents and on the page itself.
\def\@part[#1]#2{%
    \ifnum \c@secnumdepth > -2\relax
        % If the section numbering depth allows parts to be numbered
        \refstepcounter{part}% Increment the part counter
        \ABNTaddcontentsline{toc}{part}{{\partname~\thepart}~ #1}% Add the part to the TOC with numbering
    \else
        % If section numbering depth does not include parts
        \resetsubcounters{part}% Reset subordinate counters
        \ABNTaddcontentsline{toc}{part}{#1}% Add the part to the TOC without numbering
    \fi

    % Clear the header and footer for part pages
    \markboth{}{}%

    % Format the part title on the part page
    {\centering% Center the part title
        \interlinepenalty \@M% Prevent page breaks between lines in the title
        \normalfont% Use the normal font style

        \ifnum \c@secnumdepth > -2\relax
            % If the section numbering depth allows part numbering
            \ABNTchapterfont\huge% Use custom font and large size for the part number
            \ifthenelse{\boolean{ABNTcapchap}}% Check if capitalization is enabled
                {\MakeUppercase{\partname~\thepart}}% Use uppercase for the part name and number
                {\partname~\thepart}% Regular case for the part name and number
            \par% Start a new paragraph
            \vskip 20\p@% Add vertical space after the part number
        \fi

        \ABNTchapterfont\Huge% Use custom font and very large size for the part title
        \ifthenelse{\boolean{ABNTcapchap}}% Check if capitalization is enabled
            {\MakeUppercase{#2}}% Use uppercase for the part title
            {#2}% Regular case for the part title
        \par% End the title with a new paragraph
    }%
    \@endpart% End the part
}

% Chapter pages: custom glyph, plain style, pre-text/after-TOC handling.
\renewcommand\chapter{%
    % Clear the page before a new chapter, handling 'openright' option
    \ITU@clearpage

    % Add a custom chapter image at a specific position
    \ITU@chapterglyph{chapter.png}%

    % Apply the specific page style for the chapter title page
    \thispagestyle{\chaptertitlepagestyle}%

    % Handle settings for pre-textual and post-TOC conditions
    \ifthenelse{\boolean{ABNTinpretext}}{% Check if in pre-text section
        \ifthenelse{\boolean{ABNTaftertoc}}{% Check if after the table of contents
            \setboolean{ABNTinpretext}{false}% Update pre-text flag
            \ABNTBeginOfTextualPart% Trigger start of textual part
        }{}% No action if not after TOC
    }{}% No action if not in pre-text

    % Prevent floats from appearing at the top of the page
    \global\@topnum\z@

    % Disable indentation after chapter titles
    \@afterindentfalse

    % Define sectioning behavior for numbered and unnumbered chapters
    \secdef\@chapter\@schapter
}

% Pre-textual chapters (abstract, lists, ...): header glyph instead of chapter
% glyph, always unnumbered.
\renewcommand\pretextualchapter{%
    % Clear the page before starting a new pre-textual chapter, respecting 'openright' option
    \ITU@clearpage

    % Add the decorative header rules for pre-textual chapters
    \ITU@headerglyph%

    % Add vertical space below the image
    \vspace{6pt}%

    % Apply the specific page style for the pre-textual chapter title page
    \thispagestyle{\chaptertitlepagestyle}%

    % Prevent floats from appearing at the top of the page
    \global\@topnum\z@

    % Disable indentation after pre-textual chapter titles
    \@afterindentfalse%

    % Call the unnumbered chapter sectioning command
    \@schapter%
}

% Chapter-title band geometry (matched to the two decorative rules drawn in
% style/chapter.png). Offsets are measured from the text top, where the glyph is
% anchored; tune these if the artwork changes.
\newsavebox{\ITU@titlebox}
\newsavebox{\ITU@numbox}
\newlength{\ITU@titlemaxheight}\setlength{\ITU@titlemaxheight}{74pt}% ~3 lines at \ABNTchaptersize
\newlength{\ITU@titlepos}\setlength{\ITU@titlepos}{-16pt}% band centre, measured down from the text top
\newlength{\ITU@headskip}\setlength{\ITU@headskip}{154pt}% space before the body text (clears the glyph)
\newlength{\ITU@numposx}\setlength{\ITU@numposx}{391pt}% box centre, to the right of the left margin
\newlength{\ITU@numposy}\setlength{\ITU@numposy}{52pt}% box centre, above the putat origin
\newlength{\ITU@numgap}\setlength{\ITU@numgap}{2pt}% gap between "Chapter" and the number
\newlength{\ITU@titleoff}% scratch: raise that recentres a box on its own geometric middle
\newlength{\ITU@numoff}% scratch: same, for the name/number box

% Typeset the chapter title into \ITU@titlebox, shrinking the font until the
% block fits within \ITU@titlemaxheight (so titles longer than ~3 lines are
% scaled down and stay inside the band).
\newcommand{\ITU@fittitle}[1]{%
    \normalfont\ABNTchaptersize\ABNTchapterfont% Start from the custom chapter size and font
    \dimen@=\f@size\p@% Current font size as the starting point
    \def\ITU@titletext{% Respect the capitalization option
        \ifthenelse{\boolean{ABNTcapchap}}{\MakeUppercase{#1}}{#1}%
    }%
    \fontsize{\dimen@}{1.2\dimen@}\selectfont
    \sbox{\ITU@titlebox}{\parbox[c]{\linewidth}{\centering\ITU@titletext\par}}%
    \@whiledim\dimexpr\ht\ITU@titlebox+\dp\ITU@titlebox\relax>\ITU@titlemaxheight\do{%
        \dimen@=.95\dimen@% Shrink and re-typeset until it fits
        \fontsize{\dimen@}{1.2\dimen@}\selectfont
        \sbox{\ITU@titlebox}{\parbox[c]{\linewidth}{\centering\ITU@titletext\par}}%
    }%
}

% Layout of the chapter name and number.
%
% Both the chapter title and the "Chapter <n>" name/number are drawn as absolute
% overlays (\putat, anchored to the text top exactly like the glyph itself), so
% their positions do not depend on the flow baseline of the surrounding text.
% The title is centred between the two rules of the glyph; the name/number is
% stacked (name and number sharing one vertical axis) and centred inside the
% square box drawn in the glyph.
\def\@makechapterhead#1{
    {%
        % Leading empty overlay fixes \topskip so the anchor is identical for any
        % content height (needed for the multi-line title to centre correctly).
        \putat{0}{\ITU@titlepos}{}%
        % Title: auto-fitted, recentred on its own geometric middle, dropped onto
        % \ITU@titlepos (the band centre).
        \ITU@fittitle{#1}%
        \setlength{\ITU@titleoff}{-.5\ht\ITU@titlebox}%
        \addtolength{\ITU@titleoff}{.5\dp\ITU@titlebox}%
        \putat{0}{\ITU@titlepos}{%
            \raisebox{\ITU@titleoff}[0pt][0pt]{\usebox{\ITU@titlebox}}%
        }%
        % Name/number: "Chapter" over the number, both centred on a common axis
        % (\shortstack), the whole stack centred on the box centre both
        % horizontally (\makebox[0pt][c] at \ITU@numposx) and vertically
        % (recentred on its middle, dropped onto \ITU@numposy).
        \sbox{\ITU@numbox}{%
            \shortstack{{\Large\chaptername}\\[\ITU@numgap]%
                \resizebox{!}{1cm}{\normalfont\thechapter}}%
        }%
        \setlength{\ITU@numoff}{-.5\ht\ITU@numbox}%
        \addtolength{\ITU@numoff}{.5\dp\ITU@numbox}%
        \putat{\ITU@numposx}{\ITU@numposy}{%
            \makebox[0pt][c]{%
                \raisebox{\ITU@numoff}[0pt][0pt]{\usebox{\ITU@numbox}}%
            }%
        }%
    }%
    % Space so the body text clears the glyph (keeps the original body start).
    \vspace{\ITU@headskip}\par
}

% Layout of the appendix/annex chapter name and number.
\def\@makeanapchapterhead#1{
    {
        % Check if appendix/annex has an indicative indent
        \ifthenelse{\boolean{ABNTAnApIndicativoIndent}}{
            % Appendix/annex name and number (independent of capitalization)
            \vspace*{-90pt}\par
            \begin{center}
                \hspace{370pt}% Adjust horizontal position
                \Large{\anapchaptername\par}% Display appendix/annex name
                \hspace{370pt}% Adjust horizontal position
                \resizebox{!}{1cm}{\thechapter\par}% Display chapter number
            \end{center}
            \vspace*{0pt}\par
        }{}

        % Add vertical spacing before the content
        \vspace*{-13pt}

        % Create a list for content formatting
        \begin{list}{}{
            \centering\normalfont\ABNTchaptersize\ABNTchapterfont% Apply custom size and font
            \setlength{\listparindent}{0cm}% Remove paragraph indentation
            \setlength{\itemindent}{-\ABNTanapindent}% Adjust item indentation
            \setlength{\rightmargin}{0cm}% Remove right margin
            \setlength{\leftmargin}{\ABNTanapindent}% Set left margin
            \setlength{\parsep}{0pt}% Remove additional spacing
        }
            \item
            % Check if a title (#1) is provided
            \ifthenelse{\equal{#1}{}}{
                % If no title, display the appendix/annex name and number
                \ifthenelse{\boolean{ABNTCapAnnexAppendix}}{
                    \MakeUppercase{\anapchaptername}% Uppercase the name if applicable
                }{
                    \anapchaptername% Regular case for the name
                }
                \thechapter \ABNTaposindicativoanap% Display the chapter number
            }{
                % If a title is provided, format it
                \ifthenelse{\boolean{ABNTCapAnnexAppendix}}{
                    \centering\ABNTaposindicativoanap% Center the indicative append
                    \vbox{\color{black} #1}\par% Title
                }{}
            }
        \end{list}

        % Add vertical spacing after the content
        \par\vspace{107pt}
    }
}

