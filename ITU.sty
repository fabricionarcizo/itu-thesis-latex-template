% =============================================================================
% ITU Package
% -----------------------------------------------------------------------------
% Formatting kernel for the (unofficial) ITU thesis template. It sits on top of
% the abnt document class (classic abnTeX) and re-skins it for English-language
% Bachelor's, Master's, Ph.D. and research-project documents.
%
% The file is organised top-down:
%   1.  Package requirements and class/package options
%   2.  abnt compatibility bridge (Portuguese -> English metadata API)
%   3.  Additional document metadata (department, program, colophon, ...)
%   4.  Thesis-type logic
%   5.  Author and co-supervisor lists
%   6.  Previous degrees and committee members
%   7.  Dedication / acknowledgment / epigraph data
%   8.  Fonts and formatting hooks
%   9.  Automatic IEEE-style citation builder
%   10. Internal layout helpers (shared boilerplate)
%   11. Page styles (headers and footers)
%   12. Sectioning (parts, chapters, chapter heads)
%   13. Table of contents, lists and glossary
%   14. Cover, colophon and sheets
%   15. Pre-textual pages (dedication, acknowledgment, epigraph)
%   16. Abstract environments (English and Danish)
%   17. Bibliography
%
% Naming convention: commands prefixed with \ITU@ are private to this package;
% commands prefixed with \ITU (no @) and the abnt bridge names are the public,
% document-level API.
% =============================================================================


% -----------------------------------------------------------------------------
% 1. Package requirements and options
% -----------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ITU}[2024/12/02]

\RequirePackage{ifthen}
\RequirePackage{xstring}
\RequirePackage[english]{babel}
\RequirePackage{scrextend}
\RequirePackage{environ}
\RequirePackage[acronym,nonumberlist]{glossaries}

% Options handed to the underlying class/packages.
\PassOptionsToClass{pnumromarab}{abnt}
\PassOptionsToPackage{hyperindex=false}{hyperref}

% Make @ a letter so the package can define and use internal @-commands.
\makeatletter

% Format the table numbers as X.Y (chapter.counter).
\renewcommand{\thetable}{\thechapter.\arabic{table}}


% -----------------------------------------------------------------------------
% 2. abnt compatibility bridge (Portuguese -> English metadata API)
% -----------------------------------------------------------------------------
% The underlying document class (abnt.cls, classic abnTeX) exposes a Portuguese
% API. This block is the single seam between that API and the English names used
% throughout the rest of this package: everything below reads in English, and
% the Portuguese identifiers are confined here.

% English storage macros for the abnt metadata fields. Fields with an ITU setter
% (below) are stored as real macros so their *value* is available for low-level
% expansion (e.g. \ITU@citationyear), and mirrored into the abnt field. Author and
% co-supervisor are derived lists, so they are simple read-aliases (safe:
% \ABNTifnotempty fully expands its argument before testing it).
\providecommand{\ABNTuniversitydata}{}
\providecommand{\ABNTtitledata}{}
\providecommand{\ABNTsupervisordata}{}
\providecommand{\ABNTcitydata}{}
\providecommand{\ABNTdatedata}{}
\newcommand{\ABNTauthordata}{\ABNTautordata}
\newcommand{\ABNTcosupervisordata}{\ABNTcoorientadordata}

% English-named handles for the abnt author/co-supervisor field setters, used to
% push the derived inline lists into the abnt fields.
\let\ABNTsyncauthorfield\autor
\let\ABNTsynccosupervisorfield\coorientador

% Translate the main commands to English. Each metadata setter stores the value
% into its English macro and mirrors it into the corresponding abnt field.
\newcommand{\university}[1]{\renewcommand{\ABNTuniversitydata}{#1}\instituicao{#1}}
\newcommand{\maintitle}[1]{\renewcommand{\ABNTtitledata}{#1}\titulo{#1}}
\renewcommand{\author}[1]{\ITUaddauthor{#1}}
\newcommand{\supervisor}[1]{\renewcommand{\ABNTsupervisordata}{#1}\orientador{#1}}
\newcommand{\cosupervisor}[1]{\ITUaddcosupervisor{#1}}
\newcommand{\city}[1]{\renewcommand{\ABNTcitydata}{#1}\local{#1}}
% The date setter stores into the English macro and the abnt field; \date is the
% English name and \data (abnt's) is kept working as an alias.
\renewcommand{\data}[1]{\renewcommand{\ABNTdatedata}{#1}\renewcommand{\ABNTdatadata}{#1}}
\let\date\data
\newcommand{\cover}[1]{\capa}
\newcommand{\contents}{\sumario}
\renewcommand{\annexname}{Annex}
\newcommand{\coversheet}[1]{\folhaderosto}
\newcommand{\approvalsheet}[1]{\folhaaprovacao}

% English spacing environments, equivalent to abnt.cls's espacosimples /
% espacoumemeio (which wrap setspace's `spacing` with ratios 1.0 / 1.35).
\newenvironment{ITUsinglespacing}{\begin{spacing}{1.0}}{\end{spacing}}
\newenvironment{ITUonehalfspacing}{\begin{spacing}{1.35}}{\end{spacing}}


