% Committee members. Three slots (A/B/C); \committeeMemberX[role]{name} stores
% the name and role. \ITU@defcommittee generates each slot's storage and setter,
% differing only in the default role of the optional argument.
\newcommand{\ITU@defcommittee}[2]{%
    \expandafter\providecommand\csname committeeName#1\endcsname{}%
    \expandafter\providecommand\csname committeeData#1\endcsname{}%
    \expandafter\newcommand\csname committeeMember#1\endcsname[2][#2]{%
        \expandafter\renewcommand\csname committeeName#1\endcsname{##2}%
        \expandafter\renewcommand\csname committeeData#1\endcsname{##1}}%
}
\ITU@defcommittee{A}{Chair}
\ITU@defcommittee{B}{}
\ITU@defcommittee{C}{}


