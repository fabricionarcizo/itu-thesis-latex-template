% Multiple authors (one to three). Each \author call registers one author, so a
% single call behaves exactly like before. The registered names are exposed as
% two render helpers: \ITUauthorslined stacks them one per line (used on the
% cover and cover sheet) and \ITUauthorsinline prints a grammatical list
% ("A", "A and B", or "A, B and C") used in running text such as the approval
% statement. The ABNT author field is kept in sync so emptiness checks and any
% legacy references keep working.
\newcounter{ITUnumauthors}
\providecommand{\ITUauthorA}{}
\providecommand{\ITUauthorB}{}
\providecommand{\ITUauthorC}{}
\newcommand{\ITUaddauthor}[1]{%
    \stepcounter{ITUnumauthors}%
    \ifcase\value{ITUnumauthors}%
        \or\renewcommand{\ITUauthorA}{#1}%
        \or\renewcommand{\ITUauthorB}{#1}%
        \or\renewcommand{\ITUauthorC}{#1}%
        \else\PackageError{ITU}{At most three authors are supported}%
            {Use no more than three \string\author\space commands.}%
    \fi
    \ABNTsyncauthorfield{\ITUauthorsinline}%
}
\newcommand{\ITUauthorsinline}{%
    \ifcase\value{ITUnumauthors}%
    \or\ITUauthorA
    \or\ITUauthorA{} and \ITUauthorB
    \or\ITUauthorA, \ITUauthorB{} and \ITUauthorC
    \fi
}
\newcommand{\ITUauthorslined}{%
    \ifcase\value{ITUnumauthors}%
    \or\ITUauthorA
    \or\ITUauthorA\\\ITUauthorB
    \or\ITUauthorA\\\ITUauthorB\\\ITUauthorC
    \fi
}

% Multiple co-supervisors (one to three), mirroring the multi-author handling.
% Each \cosupervisor call registers one name. \ITUcosupinline prints a
% grammatical list ("A", "A and B", or "A, B and C") and \ITUcosuplabel gives an
% adaptive label ("Co-Supervisor:" for one, "Co-Supervisors:" for several). The
% ABNT co-supervisor field is kept in sync so emptiness checks keep working.
\newcounter{ITUnumcosup}
\providecommand{\ITUcosupA}{}
\providecommand{\ITUcosupB}{}
\providecommand{\ITUcosupC}{}
\newcommand{\ITUaddcosupervisor}[1]{%
    \stepcounter{ITUnumcosup}%
    \ifcase\value{ITUnumcosup}%
        \or\renewcommand{\ITUcosupA}{#1}%
        \or\renewcommand{\ITUcosupB}{#1}%
        \or\renewcommand{\ITUcosupC}{#1}%
        \else\PackageError{ITU}{At most three co-supervisors are supported}%
            {Use no more than three \string\cosupervisor\space commands.}%
    \fi
    \ABNTsynccosupervisorfield{\ITUcosupinline}%
}
\newcommand{\ITUcosupinline}{%
    \ifcase\value{ITUnumcosup}%
    \or\ITUcosupA
    \or\ITUcosupA{} and \ITUcosupB
    \or\ITUcosupA, \ITUcosupB{} and \ITUcosupC
    \fi
}
\newcommand{\ITUcosuplabel}{%
    \ifnum\value{ITUnumcosup}>1 Co-Supervisors:\else Co-Supervisor:\fi
}

% Automatic IEEE-style bibliographic citation for the colophon, assembled from
% the document metadata (authors, title, thesis type, university, place, year).
% A manual \citationinfo{...} still overrides it (see \infopage).
%
% \ITUinitials abbreviates all given names of a full name to initials and keeps
% the surname, e.g. "Fabricio Batista Narcizo" -> "F. B. Narcizo".
\newcommand{\ITU@ifempty}[1]{%
    \expandafter\ifx\expandafter\relax\detokenize{#1}\relax
        \expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\newcommand{\ITUinitials}[1]{\ITU@ini#1 \ITU@ninil}
\def\ITU@ini#1 #2\ITU@ninil{%
    \ITU@ifempty{#2}{#1}{\ITU@fc#1\ITU@ninil.~\ITU@ini#2\ITU@ninil}}
\def\ITU@fc#1#2\ITU@ninil{#1}
% One-expansion wrapper so a stored name macro is split, not its single token.
\newcommand{\ITUinitialsx}[1]{\expandafter\ITUinitials\expandafter{#1}}

% Registered authors joined in IEEE order ("A", "A and B", "A, B, and C").
\newcommand{\ITUauthorsieee}{%
    \ifcase\value{ITUnumauthors}%
    \or\ITUinitialsx{\ITUauthorA}%
    \or\ITUinitialsx{\ITUauthorA} and \ITUinitialsx{\ITUauthorB}%
    \or\ITUinitialsx{\ITUauthorA}, \ITUinitialsx{\ITUauthorB}, and \ITUinitialsx{\ITUauthorC}%
    \fi}

% Year = last space-separated token of the date ("July, 2026" -> "2026").
\newcommand{\ITUcitationyear}{\expandafter\ITU@lwstart\expandafter{\ABNTdatedata}}
\def\ITU@lwstart#1{\ITU@lw#1 \ITU@ninil}
\def\ITU@lw#1 #2\ITU@ninil{\ITU@ifempty{#2}{#1}{\ITU@lw#2\ITU@ninil}}

% Place = the \city value with " -- " normalised to ", ".
\newcommand{\ITUcitationplace}{{\fullexpandarg\StrSubstitute{\ABNTcitydata}{ -- }{, }}}

% The assembled citation.
\newcommand{\ITUautocitation}{%
    \ITUauthorsieee, ``\ABNTtitledata : \ABNTsubtitledata,'' \ABNTthesisdata,
    \ABNTuniversitydata, \ITUcitationplace, \ITUcitationyear.}

% Signature blocks for the cover sheet: a centered rule with the author's name
% centered underneath. \ITUsignatures renders one block per registered author
% (1 to 3), so the signature area adapts to the number of authors.
\newcommand{\ITUsignatureblock}[1]{%
    \rule{0.6\textwidth}{0.5pt}\\[2pt]
    #1\par
}

\newcommand{\ITUsignatures}{%
    \begin{center}
        \ifcase\value{ITUnumauthors}%
        \or
            \ITUsignatureblock{\ITUauthorA}%
        \or
            \ITUsignatureblock{\ITUauthorA}%
            \vspace{8mm}%
            \ITUsignatureblock{\ITUauthorB}%
        \or
            \ITUsignatureblock{\ITUauthorA}%
            \vspace{8mm}%
            \ITUsignatureblock{\ITUauthorB}%
            \vspace{8mm}%
            \ITUsignatureblock{\ITUauthorC}%
        \fi
    \end{center}%
}

% Thesis type configuration: bachelor | master | phd | research. A single
% \thesistype command drives the document level: it sets a boolean for the
% chosen type, auto-fills the type label (\subtitle) and the long degree
% wording, and lets the cover/approval sheets self-suppress accordingly.
\newif\ifITUphd
\newif\ifITUmaster
\newif\ifITUbachelor
\newif\ifITUresearch
\providecommand{\thesisdegreelong}{}   % e.g. "Doctor of Philosophy"
\newcommand{\thesistype}[1]{%
    \ITUphdfalse\ITUmasterfalse\ITUbachelorfalse\ITUresearchfalse
    \renewcommand{\thesisdegreelong}{}%
    \ifthenelse{\equal{#1}{phd}}{%
        \ITUphdtrue \thesis{Ph.D. Thesis}%
        \renewcommand{\thesisdegreelong}{Doctor of Philosophy}%
    }{\ifthenelse{\equal{#1}{master}}{%
        \ITUmastertrue \thesis{Master's Thesis}%
        \renewcommand{\thesisdegreelong}{Master of Science}%
    }{\ifthenelse{\equal{#1}{bachelor}}{%
        \ITUbachelortrue \thesis{Bachelor's Thesis}%
        \renewcommand{\thesisdegreelong}{Bachelor of Science}%
    }{\ifthenelse{\equal{#1}{research}}{%
        \ITUresearchtrue \thesis{Research Project}%
    }{\PackageError{ITU}{Unknown thesis type '#1' (use bachelor, master, phd, or research)}{}%
    }}}}%
}

