        \end{ITUsinglespacing}

        \vspace{0.75cm}

        \begin{ITUsinglespacing}
            \noindent\hrulefill\\
            Dr.~\committeeNameA, \committeeDataA % Committee member A
        \end{ITUsinglespacing}

        \vspace{0.75cm}

        \begin{ITUsinglespacing}
            \noindent\hrulefill\\
            Dr.~\committeeNameB % Committee member B
        \end{ITUsinglespacing}

        \vspace{0.75cm}

        \begin{ITUsinglespacing}
            \noindent\hrulefill\\
            Dr.~\committeeNameC % Committee member C
        \end{ITUsinglespacing}

        \vspace{0.75cm}

        \begin{ITUsinglespacing}
            \noindent\hrulefill\\
            Date
        \end{ITUsinglespacing}
