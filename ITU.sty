% Height of the top banner (~42% of an A4 page); the photo fills the remainder.
\newlength{\bannerheight}
\setlength{\bannerheight}{110mm}

% Redefine the \capa (cover page) command as a full-bleed design: a solid
% banner across the top holding the logo, institution details, title and work
% type, with the cover photograph filling the lower portion of the page.
\renewcommand{\capa}{
    % Solid color used for the cover banner. The logo (style/logo.png) is a
    % white wordmark on a black background, so a black banner lets it blend in.
    \definecolor{coverbanner}{RGB}{0,0,0}
    \begin{titlepage} % Start the title page
        \setcounter{page}{0} % Set the page number to 0
        \thispagestyle{empty} % No header/footer on the cover

        % This full-page overlay uses the current page node, which cannot be
        % externalized, so skip TikZ externalization for this picture.
        \tikzexternaldisable
        \begin{tikzpicture}[remember picture, overlay]
            % --- Cover photograph: full page width, clipped to the lower
            %     region so its aspect ratio is preserved (bottom is cropped).
            \begin{scope}
                \clip ([yshift=-\bannerheight]current page.north west)
                      rectangle (current page.south east);
                \node[anchor=north, inner sep=0]
                    at ([yshift=-\bannerheight]current page.north)
                    {\includegraphics[width=\paperwidth]{style/cover.png}};
            \end{scope}

            % --- Top banner.
            \fill[coverbanner] (current page.north west)
                  rectangle ([yshift=-\bannerheight]current page.north east);

            % --- Institution logo, top-left corner of the banner.
            \node[anchor=north west, inner sep=0]
                at ([shift={(12mm,-12mm)}]current page.north west)
                {\includegraphics[width=20mm]{style/logo.png}};

            % --- Institution and department, top-right corner of the banner.
            \node[anchor=north east, align=right, text=white, text width=95mm]
                at ([shift={(-12mm,-12mm)}]current page.north east)
                {\ABNTifnotempty{\ABNTuniversitydata}{%
                     {\bfseries\normalsize\ABNTuniversitydata\par}}%
                 \vspace{-1.75mm}%
                 \ABNTifnotempty{\ABNTdepartmentdata}{%
                     {\mdseries\normalsize\ABNTdepartmentdata\par}}};

            % --- Title, programme and work type, lower-left of the banner.
            \node[anchor=south west, align=left, text=white, text width=170mm]
                at ($(current page.north west)+(12mm,12mm)-(0pt,\bannerheight)$)
                {\ABNTifnotempty{\ABNTtitledata}{%
                    {\bfseries\fontsize{25pt}{24pt}\selectfont\ABNTtitledata\par}}%
                 \ABNTifnotempty{\ABNTsubtitledata}{%
                    {\fontsize{22pt}{24pt}\selectfont\ABNTsubtitledata\par}}%
                 \ABNTifnotempty{\ABNTauthordata}{%
                    \vspace{6mm}%
                    {\fontsize{17pt}{16pt}\selectfont
                    \ITUauthorslined\par}}%
                 \ABNTifnotempty{\ABNTthesisdata}{%
                     {\large\ABNTthesisdata\par}}};
        \end{tikzpicture}
        \tikzexternalenable
    \end{titlepage}
}

% Colophon / information page (placed between the cover and the cover sheet).
% A single label:value row: a fixed-width, left-aligned label followed by a
% top-aligned paragraph box so long values wrap with a hanging indent under the
% value column.
\newcommand{\ITUinforow}[2]{%
    \noindent\makebox[3cm][l]{#1}%
    \parbox[t]{\dimexpr\linewidth-3cm\relax}{#2}\par\smallskip
}

% The \infopage command: a mostly empty page whose content sits at the bottom,
% left-aligned, echoing the imprint page of the reference design.
\newcommand{\infopage}{%
    % Ensure the page starts on a fresh sheet.
    \if@openright
        \cleardoublepage
    \else
        \clearpage
    \fi
    \if@twocolumn
        \@restonecoltrue\onecolumn
    \else
        \@restonecolfalse\newpage
    \fi
    \thispagestyle{empty}%

    {%
        \setstretch{1}%

        % Push the whole block to the bottom of the page.
        \vspace*{\fill}
        \noindent

        % Title block.
        {%
            \setlength{\parskip}{0pt}%
            \noindent
            \ABNTifnotempty{\ABNTtitledata}{%
                {\bfseries\small\ABNTtitledata\par}%
            }%
            \noindent
            \ABNTifnotempty{\ABNTsubtitledata}{%
                {\small\ABNTsubtitledata\par}%
            }%
        }%
        \medskip

        % Thesis type and date.
        {%
            \setlength{\parskip}{0pt}%
            \noindent
            \ABNTifnotempty{\ABNTthesisdata}{%
                {\small\ABNTthesisdata\par}%
            }%
            \noindent
            \ABNTifnotempty{\ABNTdatedata}{%
                {\small\ABNTdatedata\par}%
            }%
        }%
        \medskip

        % Author(s).
        {%
            \setlength{\parskip}{0pt}%
            \noindent
            {\small By\par}
            \noindent
            {\small\ITUauthorslined\par}
        }%
        \bigskip

        % Supervision.
        {%
            \setlength{\parskip}{0pt}%
            \noindent
            \ABNTifnotempty{\ABNTsupervisordata}{%
                \ITUinforow{\small Supervisor:}%
                           {\small\ABNTsupervisordata}%
            }%
            \noindent
            \ABNTifnotempty{\ABNTcosupervisordata}{%
                \ITUinforow{\small\ITUcosuplabel}%
                           {\small\ITUcosupinline}%
            }%
        }%
        \medskip

        % Copyright, publisher, and citation.
        \ABNTifnotempty{\ABNTcopyrightdata}{%
            \ITUinforow{\small Copyright:}%
                       {\small\ABNTcopyrightdata}%
        }%

        \ITUinforow{\small Published by:}{%
            \small\ABNTuniversitydata, \ABNTdepartmentdata
            \ABNTifnotempty{\ABNTuniversityaddressdata}{\newline\ABNTuniversityaddressdata}%
            \ABNTifnotempty{\ABNTuniversityphonenumberdata}{\newline\ABNTuniversityphonenumberdata}%
            \ABNTifnotempty{\ABNTuniversitywebsitedata}{\newline\ABNTuniversitywebsitedata}%
        }%

        % The citation is generated automatically from the document metadata; a
        % manual \citationinfo{...} overrides it when provided.
        \ITUinforow{\small Citation:}%
                   {\small\expandafter\ITU@ifempty\expandafter{\ABNTcitationdata}{\ITUautocitation}{\ABNTcitationdata}}%

        \vspace*{1cm}%
    }%
}

% Back cover: the last page of the document. A full black page with white text --
% the English summary (reused verbatim from the abstract environment, stored in
% \ABNTsummarydata) at the top, and the university contact details at the bottom.
% Modeled on \capa: a full-page TikZ overlay with white-text nodes, wrapped in
% \tikzexternaldisable/\tikzexternalenable because the document enables TikZ
% externalization and a "remember picture, overlay" picture cannot be externalized.
\newcommand{\backcover}{%
    \cleardoublepage
    \begin{titlepage}%
        \thispagestyle{empty}%
        \tikzexternaldisable
        \begin{tikzpicture}[remember picture, overlay]
            % Full black background.
            \fill[black] (current page.north west)
                  rectangle (current page.south east);

            % Top: English summary (reused abstract text), white, justified.
            \node[anchor=north, align=justify, text=white, text width=150mm]
                at ([yshift=-30mm]current page.north)
                {\ABNTifnotempty{\ABNTsummarydata}{%
                     \small\ABNTsummarydata\par}};

            % Bottom: university contact, white, left-aligned.
            \node[anchor=south west, align=left, text=white, text width=150mm]
                at ([shift={(30mm,25mm)}]current page.south west)
                {\ABNTifnotempty{\ABNTuniversitydata}{%
                     {\bfseries\small\ABNTuniversitydata\par}}%
                 \ABNTifnotempty{\ABNTuniversityaddressdata}{%
                     {\small\ABNTuniversityaddressdata\par}}%
                 \ABNTifnotempty{\ABNTuniversityphonenumberdata}{%
                     {\small\ABNTuniversityphonenumberdata\par}}%
                 \ABNTifnotempty{\ABNTuniversitywebsitedata}{%
                     {\ABNTuniversitywebsitedata\par}}};
        \end{tikzpicture}
        \tikzexternalenable
    \end{titlepage}%
}

% Redefine the \folhaderosto (cover sheet) command
\renewcommand{\folhaderosto}{
    % A Research Project has no formal cover sheet; skip the whole page.
    \ifITUresearch\else
    % Ensure the cover sheet starts on the correct page
    \if@openright
        \cleardoublepage % Start on the right page
    \else
        \clearpage % Start on the next available page
    \fi

    % Handle two-column formatting
    \if@twocolumn
        \@restonecoltrue\onecolumn % Switch to single-column layout
    \else
        \@restonecolfalse\newpage % Add a new page if not in two-column mode
    \fi

    % Set the initial vertical alignment and page style
    \vspace*{0cm}
    \thispagestyle{empty}

    % Display the title
    \begin{center}
        \ABNTifnotempty{\ABNTtitledata}{%
            \programformat{\ABNTtitledata} % Format and display the title
        }
    \end{center}

    % Display "by"
    \begin{center}
        by
    \end{center}

    % Display the author name
    \thispagestyle{empty}
    \begin{center}
        \ABNTifnotempty{\ABNTauthordata}{%
            \ITUauthorformat\ITUauthorslined % Format and display the author name(s)
        }
    \end{center}

    % Display the degree information
    \begin{center}
        \ABNTifnotempty{\bachelorDegree}{%
            \vspace{0.75cm}
            \bachelorDegree\\ % Bachelor degree information
        }
        \ABNTifnotempty{\masterDegree}{%
            \masterDegree\\ % Master degree information
        }
    \end{center}

    % Display the thesis statement
    \vspace{0.75cm}
    \begin{addmargin}[8em]{8em}
        \begin{center}
            A thesis submitted in partial fulfillment of the requirements for the degree of \thesisdegreelong{} in the~\ABNTdepartmentdata\\
            \ABNTuniversitydata % Institution and department details
        \end{center}
    \end{addmargin}

    % Display the date
    \begin{center}
        \ABNTifnotempty{\ABNTdatedata}{%
            {\ITUdateformat\ABNTdatedata} % Format and display the date
        }
    \end{center}

    % Author signature(s): a centered line with the author name underneath,
    % one signature block per registered author. The blocks are distributed in
    % the remaining space so one, two, or three authors all fit on the page.
    \vfill
    \ITUsignatures

    % Fill the remaining space on the page
    \vspace*{\fill}
    \fi
}

